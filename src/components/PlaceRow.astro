---
import StationBadge from './StationBadge.astro';
import T from './T.astro';
import U from './U.astro';
import type { Line, Place, Zh } from '../lib/data';
import { closedText, hoursText } from '../lib/time';

interface Props {
  place: Place;
  line: Line;
  /** Chinese for this place, if translated. */
  zh?: Zh['places'][string];
}

const { place: p, line, zh = {} } = Astro.props;
const schedule = (lang: 'en' | 'zh') => [hoursText(p.hours, lang), closedText(p.closed_days, lang)].filter(Boolean).join(' · ');
---

<li
  class="row"
  data-place={p.id}
  data-zone={p.zone}
  data-hours={JSON.stringify(p.hours)}
  data-closed={p.closed_days.join(',')}
  data-verified={String(p.hours_verified)}
>
  <a href={`/p/${p.id}/`}>
    <span class="head">
      <span class="names">
        <span class="en t20">{p.name_en}</span>
        {p.name_ja !== p.name_en && <span class="ja" lang="ja">{p.name_ja}</span>}
      </span>
      <span class="tag" data-tag hidden></span>
    </span>
    <span class="tags">
      <span class="tag yamabuki"><T en={p.recognition} zh={zh.recognition} /></span>
      {p.book_ahead && <span class="tag coral"><U k="row.bookAhead" /></span>}
    </span>
    <span class="why"><T en={p.why} zh={zh.why} /></span>
    <span class="meta">
      <StationBadge line={line} station={p.station} />
      <span class="num"><T en={p.price} zh={zh.price} /></span>
    </span>
    <span class="hours t13">
      <span class="tag open" data-open></span>
      <span class="muted"><T en={schedule('en')} zh={schedule('zh')} /></span>
    </span>
    <span class="planned t13" data-planned hidden></span>
  </a>
</li>

<style>
  .row a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 18px 16px;
    background: var(--card);
    border: var(--line) solid var(--ink);
    border-radius: var(--r-card);
    text-decoration: none;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .names > span {
    display: block;
  }
  .en {
    display: inline !important;
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: var(--mizu);
    text-decoration-thickness: var(--line);
    text-underline-offset: 5px;
  }
  .ja {
    margin-top: 2px;
  }
  .tags,
  .meta,
  .hours {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
  }
  .tags {
    gap: 6px;
  }
  .open:empty {
    display: none;
  }
  .planned {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: var(--coral-tint);
  }
  .row[data-mark='skip'] a {
    border-style: dashed;
    background: var(--washi);
  }
</style>
