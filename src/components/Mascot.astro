---
// The mascot: a little Ginza-line car (the trip's spine, Suehirocho G14),
// orange body, ink outline, two dot eyes. Decorative; links that hold it
// carry their own label.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['mascot', className]} viewBox="0 0 48 44" aria-hidden="true" focusable="false">
  <g stroke="#3E3A39" stroke-width="3" stroke-linejoin="round">
    <rect x="17" y="2.5" width="14" height="6.5" rx="3" fill="#FFFCF6"></rect>
    <rect x="5" y="8" width="38" height="28" rx="10" fill="#FF9500"></rect>
    <rect x="11" y="13" width="26" height="12" rx="5" fill="#FFFCF6"></rect>
    <circle cx="15" cy="39.5" r="2.6" fill="#3E3A39"></circle>
    <circle cx="33" cy="39.5" r="2.6" fill="#3E3A39"></circle>
  </g>
  <g stroke="#3E3A39" stroke-width="2" fill="#FFFCF6">
    <circle cx="12.5" cy="30.5" r="1.8"></circle>
    <circle cx="35.5" cy="30.5" r="1.8"></circle>
  </g>
  <g class="eyes" fill="#3E3A39">
    <circle cx="19" cy="19" r="2.5"></circle>
    <circle cx="29" cy="19" r="2.5"></circle>
  </g>
</svg>

<style>
  .eyes {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: blink 5s infinite;
  }
  @keyframes blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.15);
    }
  }
</style>
