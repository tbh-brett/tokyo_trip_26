---
import Base from '../../layouts/Base.astro';
import DayCard from '../../components/DayCard.astro';
import DayTrack from '../../components/DayTrack.astro';
import SectionHead from '../../components/SectionHead.astro';
import T from '../../components/T.astro';
import U from '../../components/U.astro';
import { bookingDate, loadData } from '../../lib/data';
import { claudeCodeUrl } from '../../lib/ask';
import { dateIn, ui } from '../../i18n/ui';

const data = await loadData();
const { days, zh, stay, flights } = data;
const year = Number(days[0].date.slice(0, 4));
const bookings = data.bookings.map((b) => ({ ...b, date: bookingDate(b.when, year) }));
const due = (d: string, lang: 'en' | 'zh') => (d === 'now' ? ui('due.now', lang) : d === 'trip' ? ui('due.trip', lang) : dateIn(d, lang));
const when = (b: (typeof bookings)[number], lang: 'en' | 'zh') =>
  b.date ? dateIn(b.date, lang) : b.when === 'Now' ? ui('due.now', lang) : ui('when.anyTime', lang);
const names = data.travellers.map((t) => t.name);
---

<Base title={ui('plan.title', 'en')} titleZh={ui('plan.title', 'zh')} tab="plan">
  <header class="page-head">
    <SectionHead icon="list" tone="coral" level={1}><U k="plan.title" /></SectionHead>
    <p class="muted"><U k="plan.shared" v={{ names: names.join(ui('list.and', 'en')) }} vz={{ names: names.join(ui('list.and', 'zh')) }} /></p>
  </header>

  <section class="section" aria-labelledby="days-h">
    <SectionHead icon="train" tone="coral" id="days-h"><U k="today.theDays" v={{ n: days.length }} /></SectionHead>
    <DayTrack days={days} />
    <ol class="daylist">
      {
        days.map((d, i) => (
          <li>
            <DayCard day={d} n={i + 1} zh={zh.days[d.date]} stay={stay} flights={flights} href={`/day/${d.date}/`} />
            <div class="preview" data-day-preview={d.date} data-max="6" />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="want-h">
    <SectionHead icon="star" tone="coral" id="want-h"><U k="plan.want" /></SectionHead>
    <p class="t13 muted"><U k="plan.wantHint" /></p>
    <ul class="rows-lite card" data-wantlist></ul>
  </section>

  <section class="section" aria-labelledby="book-h">
    <SectionHead icon="calendar" tone="yamabuki" id="book-h"><U k="plan.bookings" /></SectionHead>
    <ul class="checklist card">
      {
        bookings.map((b) => {
          const z = zh.bookings[b.id];
          return (
            <li data-check-row>
              <label class="check">
                <input type="checkbox" data-check={`booking:${b.id}`} />
                <span class="check-body">
                  <span class="tag yamabuki">
                    <T en={when(b, 'en')} zh={when(b, 'zh')} />
                  </span>
                  <span class="t20 item-text">
                    <T en={b.what} zh={z?.what} />
                  </span>
                  <span>
                    <T en={b.detail} zh={z?.detail} />
                  </span>
                  <span class="t13 muted">
                    <T en={b.where} zh={z?.where} />
                  </span>
                  <span class="t13" data-check-by />
                </span>
              </label>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="prep-h">
    <SectionHead icon="check" tone="wakatake" id="prep-h"><U k="today.beforeFly" /></SectionHead>
    <ul class="checklist card">
      {
        data.prep.map((p) => {
          const z = zh.prep[p.id];
          return (
            <li data-check-row>
              <label class="check">
                <input type="checkbox" data-check={`prep:${p.id}`} />
                <span class="check-body">
                  <span class="tag washi">
                    <T en={due(p.due, 'en')} zh={due(p.due, 'zh')} />
                  </span>
                  <span class="item-text">
                    <T en={p.item} zh={z?.item} />
                  </span>
                  <span class="t13 muted">
                    <T en={p.group} zh={z?.group} />
                  </span>
                  <span class="t13" data-check-by />
                </span>
              </label>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="feed-h">
    <SectionHead icon="chat" tone="mizu" id="feed-h"><U k="today.latest" /></SectionHead>
    <ol class="feed card" data-feed="20"></ol>
  </section>

  <section class="section" aria-labelledby="device-h">
    <SectionHead icon="phone" tone="wakatake" id="device-h"><U k="plan.device" /></SectionHead>
    <div class="device card" data-device></div>
  </section>

  <section class="section last" aria-labelledby="claude-h">
    <SectionHead icon="sparkle" tone="yamabuki" id="claude-h"><U k="plan.bigger" /></SectionHead>
    <p><U k="plan.biggerText" /></p>
    <p class="btns">
      <a class="btn" href={claudeCodeUrl('Read CLAUDE.md. I want to: ')}>
        <U k="plan.askCode" /> <span class="hint"><U k="plan.opens" /></span>
      </a>
    </p>
  </section>
</Base>

<style>
  .daylist {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .preview {
    padding: 10px 6px 0 18px;
  }
  .check-body > .tag {
    align-self: flex-start;
  }
  .checklist {
    padding-block: 2px;
  }
  .device > :global(* + *) {
    margin-top: var(--u);
  }
  .device :global(.install) {
    margin-top: calc(var(--u) * 3);
  }
  .last {
    padding-bottom: calc(var(--u) * 3);
  }
</style>

<script>
  import { PLACE_BY_ID } from '../../lib/catalog';
  import { itemsForPlace } from '../../lib/plan';
  import { date, t } from '../../scripts/lang';
  import { getPlan } from '../../scripts/store';
  import { html, mount, placeView } from '../../scripts/ui';
  import { wireChecklists, wireDayHeadlines, wireDayPreviews, wireDeviceStatus, wireFeeds } from '../../scripts/widgets';

  wireDayHeadlines();
  wireDayPreviews();
  wireChecklists();
  wireFeeds();
  wireDeviceStatus();

  mount(document.querySelector<HTMLElement>('[data-wantlist]')!, () => {
    const plan = getPlan();
    const wants = Object.entries(plan.marks)
      .filter(([, m]) => m.mark === 'want')
      .sort((a, b) => b[1].at - a[1].at)
      .map(([ref, m]) => ({ view: placeView(plan, ref), m, ref }))
      .filter((w) => w.view);
    if (!wants.length) return html`<li class="muted">${t('plan.wantEmpty')}</li>`;
    return html`${wants.map(({ view, m, ref }) => {
      const days = [...new Set(itemsForPlace(plan, ref).map((i) => date(i.day)))];
      const station = PLACE_BY_ID.get(ref)?.station;
      return html`<li><a href="${view!.href}">
        <span class="name">${view!.name}</span>${view!.nameJa ? html` <span lang="ja">${view!.nameJa}</span>` : ''}
        <span class="t13 muted">${station ? `${station} · ` : ''}${days.length ? t('plan.planned', { days: days.join(', ') }) : t('plan.notPlanned')} · ${t('plan.markedBy', { name: m.by })}</span>
      </a></li>`;
    })}`;
  });
</script>
