---
import Base from '../../layouts/Base.astro';
import PlaceRow from '../../components/PlaceRow.astro';
import T from '../../components/T.astro';
import U from '../../components/U.astro';
import { KINDS, loadData, zoneShort, type Kind } from '../../lib/data';
import { KIND_LABEL } from '../../i18n/ui';

export function getStaticPaths() {
  return KINDS.map((k) => ({ params: { kind: k.id } }));
}

const kind = Astro.params.kind as Kind;
const data = await loadData();
const [label, labelZh] = KIND_LABEL[kind];
const list = data.places.filter((p) => p.kind === kind);
const kinds = KINDS.map((k) => ({ ...k, zh: KIND_LABEL[k.id][1], n: data.places.filter((p) => p.kind === k.id).length }));
const zones = data.zones
  .map((z) => ({ id: z.id, name: zoneShort(z), zh: data.zh.zones[z.id]?.name, n: list.filter((p) => p.zone === z.id).length }))
  .filter((z) => z.n > 0);
---

<Base title={label} titleZh={labelZh} tab="places">
  <header class="page-head">
    <h1 class="t40 w700"><T en={label} zh={labelZh} /></h1>
  </header>

  <nav class="wrap" aria-label="Kind of place">
    <div class="chips">
      {
        kinds.map((k) => (
          <a class="chip" href={`/places/${k.id}/`} data-kind-link aria-current={k.id === kind ? 'page' : undefined}>
            <T en={k.label} zh={k.zh} /> <span class="n">{k.n}</span>
          </a>
        ))
      }
    </div>
  </nav>

  <div class="wrap area">
    <span class="label" id="area-label"><U k="places.area" /></span>
    <div class="chips" role="group" aria-labelledby="area-label">
      <button type="button" class="chip" data-zone-filter="" aria-pressed="true">
        <U k="places.all" /> <span class="n">{list.length}</span>
      </button>
      {
        zones.map((z) => (
          <button type="button" class="chip" data-zone-filter={z.id} aria-pressed="false">
            <T en={z.name} zh={z.zh} /> <span class="n">{z.n}</span>
          </button>
        ))
      }
    </div>
  </div>

  <section class="wrap mine" aria-labelledby="mine-h">
    <h2 class="label" id="mine-h"><U k="places.mine" /></h2>
    <ul class="rows-lite" data-mine-list={kind}></ul>
    <p class="btns"><a class="btn" href={`/add/?kind=${kind}`}><U k="day.addUnlisted" /> <span class="hint">→</span></a></p>
  </section>

  <p class="wrap t13 muted count" aria-live="polite" data-count><U k="places.count" v={{ n: list.length }} /></p>
  <ul class="rows">
    {list.map((p) => <PlaceRow place={p} line={data.line(p.line)} zh={data.zh.places[p.id]} />)}
  </ul>
</Base>

<style>
  .area {
    margin-top: calc(var(--u) * 3);
  }
  .area .label {
    margin-bottom: var(--u);
  }
  .mine {
    margin-top: calc(var(--u) * 3);
  }
  .mine .label {
    padding-bottom: var(--u);
    border-bottom: 1px solid var(--ink);
  }
  .mine .btns {
    margin-top: var(--u);
  }
  .count {
    margin-top: calc(var(--u) * 3);
    padding-bottom: var(--u);
    border-bottom: 1px solid var(--ink);
  }
</style>

<script>
  import { itemsForPlace } from '../../lib/plan';
  import { MARK_TEXT, pick } from '../../i18n/ui';
  import { date, lang, onLang, t } from '../../scripts/lang';
  import { getPlan } from '../../scripts/store';
  import { html, mount } from '../../scripts/ui';
  import { wirePlaceRows } from '../../scripts/widgets';

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-zone-filter]')];
  const rows = [...document.querySelectorAll<HTMLElement>('[data-place]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const kindLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-kind-link]')];

  function apply(zone: string) {
    if (!buttons.some((b) => b.dataset.zoneFilter === zone)) zone = '';
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.zoneFilter === zone));
    let shown = 0;
    for (const r of rows) {
      r.hidden = zone !== '' && r.dataset.zone !== zone;
      if (!r.hidden) shown++;
    }
    if (count) count.textContent = shown === 1 ? t('places.count1') : t('places.count', { n: shown });
    const query = zone ? `?zone=${zone}` : '';
    for (const a of kindLinks) a.search = query;
    history.replaceState(null, '', location.pathname + query);
  }

  for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.zoneFilter ?? ''));
  onLang(() => apply(buttons.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.zoneFilter ?? ''));
  apply(new URLSearchParams(location.search).get('zone') ?? '');
  wirePlaceRows();

  // Your own places of this kind.
  const mine = document.querySelector<HTMLElement>('[data-mine-list]')!;
  mount(mine, () => {
    const plan = getPlan();
    const places = plan.places.filter((p) => p.kind === mine.dataset.mineList);
    if (!places.length) return html`<li class="muted">${t('places.none')}</li>`;
    return html`${places.map((p) => {
      const days = [...new Set(itemsForPlace(plan, p.id).map((i) => date(i.day)))];
      const mark = plan.marks[p.id]?.mark;
      return html`<li><a href="/p/mine/?id=${p.id}">
        <span class="w500">${p.name}</span>${p.name_ja ? html` <span lang="ja">${p.name_ja}</span>` : ''}
        <span class="t13 muted">${t('places.addedBy', { name: p.by })}${days.length ? ` · ${t('plan.planned', { days: days.join(', ') })}` : ''}${mark ? ` · ${pick(MARK_TEXT[mark], lang())}` : ''}</span>
      </a></li>`;
    })}`;
  });
</script>
