---
// Today. The page is built once, so which view shows is decided in the
// browser from the date in Japan: countdown before, "Day N of 7" during,
// a look back after. The shared plan fills in what you've decided.
import Base from '../layouts/Base.astro';
import DayCard from '../components/DayCard.astro';
import DayTrack from '../components/DayTrack.astro';
import FlightCard from '../components/FlightCard.astro';
import Hero from '../components/illustrations/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import StayCard from '../components/StayCard.astro';
import T from '../components/T.astro';
import U from '../components/U.astro';
import { bookingDate, loadData } from '../lib/data';
import { dateIn, heroRange, ui } from '../i18n/ui';

const data = await loadData();
const { days, zh, stay, flights } = data;
const first = days[0].date;
const last = days[days.length - 1].date;
const year = Number(first.slice(0, 4));

const bookings = data.bookings.map((b) => ({ ...b, date: bookingDate(b.when, year) }));
const rank = (b: (typeof bookings)[number]) => (b.when === 'Now' ? 0 : b.date ? 1 : 2);
bookings.sort((a, b) => rank(a) - rank(b) || (a.date ?? '').localeCompare(b.date ?? ''));

const prep = [...data.prep].sort((a, b) => {
  const key = (d: string) => (d === 'now' ? '0' : d === 'trip' ? '9' : d);
  return key(a.due).localeCompare(key(b.due));
});
const due = (d: string, lang: 'en' | 'zh') => (d === 'now' ? ui('due.now', lang) : d === 'trip' ? ui('due.trip', lang) : dateIn(d, lang));
const when = (b: (typeof bookings)[number], lang: 'en' | 'zh') =>
  b.date ? dateIn(b.date, lang) : b.when === 'Now' ? ui('due.now', lang) : ui('when.anyTime', lang);
const length = { n: days.length, m: days.length - 1 };
---

<Base title={ui('appName', 'en')} titleZh={ui('appName', 'zh')} tab="today">
  <header class="hero">
    <div class="frame"><Hero /></div>
    <h1 class="title spaced">
      <span class="city"><U k="hero.city" /></span>{' '}
      <span class="len"><U k="hero.length" v={length} /></span>
    </h1>
    <p class="dates"><T en={heroRange(first, last, 'en')} zh={heroRange(first, last, 'zh')} /></p>
    <p class="pill big yamabuki count" data-hero-pill>&nbsp;</p>
  </header>

  <!-- During the trip: today's card, the script reveals it -->
  <div data-view="during" hidden>
    {
      days.map((d, i) => {
        const z = zh.days[d.date];
        const next = days[i + 1];
        return (
          <section class="section today" data-day={d.date} hidden>
            <DayCard day={d} n={i + 1} zh={z} stay={stay} flights={flights} href={`/day/${d.date}/`} />
            <p class="anchor" data-day-anchor={d.date}>
              <T en={d.anchor} zh={z?.anchor} />
            </p>
            <div class="next-up" data-next-up={d.date} />
            <div data-today-timeline={d.date} />
            <p class="btns">
              <a class="btn primary" href={`/day/${d.date}/`}>
                <U k="today.change" /> <span class="hint">→</span>
              </a>
            </p>
            <SectionHead icon="book" tone="mizu" level={3} small>
              <U k="today.notes" />
            </SectionHead>
            <ul class="notes card">
              {d.notes.map((n, j) => (
                <li>
                  <T en={n} zh={z?.notes[j]} />
                </li>
              ))}
            </ul>
            {next && (
              <div class="tomorrow">
                <span class="label">
                  <U k="today.tomorrow" v={{ date: dateIn(next.date, 'en') }} vz={{ date: dateIn(next.date, 'zh') }} />
                </span>
                <DayCard day={next} n={i + 2} zh={zh.days[next.date]} stay={stay} flights={flights} href={`/day/${next.date}/`} />
              </div>
            )}
          </section>
        );
      })
    }
  </div>

  {
    flights.length > 0 && (
      <section class="section" aria-labelledby="flights-h">
        <SectionHead icon="plane" tone="mizu" id="flights-h">
          <U k="flights.title" />
        </SectionHead>
        {flights.map((f) => (
          <FlightCard flight={f} />
        ))}
      </section>
    )
  }

  <section class="section" aria-labelledby="days-h">
    <SectionHead icon="train" tone="coral" id="days-h"><U k="itin.title" /></SectionHead>
    <DayTrack days={days} />
    <ol class="days">
      {
        days.map((d, i) => (
          <li>
            <DayCard day={d} n={i + 1} zh={zh.days[d.date]} stay={stay} flights={flights} href={`/day/${d.date}/`} />
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="book-h" data-view="before">
    <SectionHead icon="calendar" tone="yamabuki" id="book-h"><U k="today.bookNext" /></SectionHead>
    <ul class="checklist card">
      {
        bookings.map((b) => {
          const z = zh.bookings[b.id];
          return (
            <li data-check-row data-booking-date={b.date ?? ''}>
              <label class="check">
                <input type="checkbox" data-check={`booking:${b.id}`} />
                <span class="check-body">
                  <span class="when">
                    <span class="tag yamabuki">
                      <T en={when(b, 'en')} zh={when(b, 'zh')} />
                    </span>
                    <span class="t13 muted" data-relative />
                  </span>
                  <span class="t20 item-text">
                    <T en={b.what} zh={z?.what} />
                  </span>
                  <span>
                    <T en={b.detail} zh={z?.detail} />
                  </span>
                  <span class="t13 muted">
                    <T en={b.where} zh={z?.where} />
                  </span>
                </span>
              </label>
            </li>
          );
        })
      }
    </ul>
    <p class="t13 muted" data-done-note hidden></p>
  </section>

  <section class="section" aria-labelledby="prep-h" data-view="before">
    <SectionHead icon="check" tone="wakatake" id="prep-h"><U k="today.beforeFly" /></SectionHead>
    <ul class="checklist card">
      {
        prep.map((p) => {
          const z = zh.prep[p.id];
          return (
            <li data-check-row data-prep-due={p.due}>
              <label class="check">
                <input type="checkbox" data-check={`prep:${p.id}`} />
                <span class="check-body">
                  <span class="when">
                    <span class="tag washi">
                      <T en={due(p.due, 'en')} zh={due(p.due, 'zh')} />
                    </span>
                    <span class="t13 muted">
                      <T en={p.group} zh={z?.group} />
                    </span>
                  </span>
                  <span class="item-text">
                    <T en={p.item} zh={z?.item} />
                  </span>
                </span>
              </label>
            </li>
          );
        })
      }
    </ul>
    <p class="t13"><a href="/plan/"><U k="today.everything" /></a></p>
  </section>

  <section class="section" aria-labelledby="stay-h">
    <SectionHead icon="house" tone="yamabuki" id="stay-h"><U k="stay.title" /></SectionHead>
    <StayCard stay={stay} />
  </section>

  <section class="section last" aria-labelledby="feed-h">
    <SectionHead icon="chat" tone="mizu" id="feed-h"><U k="today.latest" /></SectionHead>
    <ol class="feed card" data-feed="5"></ol>
  </section>
</Base>

<style>
  .hero {
    max-width: 40rem;
    margin-inline: auto;
    padding: var(--g) var(--g) 0;
    text-align: center;
  }
  .frame {
    overflow: hidden;
    border: var(--line) solid var(--ink);
    border-radius: 26px;
    background: var(--washi);
  }
  .frame :global(svg) {
    width: 100%;
    height: auto;
  }
  .title {
    margin-top: 20px;
    font-size: var(--t40);
    line-height: 1.25;
  }
  .title .len {
    display: block;
    font-size: var(--t28);
  }
  :global(html[data-lang='zh']) .title .len {
    display: inline;
    font-size: inherit;
  }
  .dates {
    margin-top: 6px;
    font-size: var(--t20);
    letter-spacing: 0.04em;
  }
  .count {
    margin-top: 18px;
  }
  .today > * + * {
    margin-top: calc(var(--u) * 2);
  }
  .anchor {
    padding-inline: 4px;
  }
  .notes {
    padding-block: 4px;
  }
  .notes li {
    padding: 12px 0;
  }
  .notes li + li {
    background: radial-gradient(circle, var(--ink) 1.5px, transparent 1.9px) 0 0 / 8px 4px repeat-x;
  }
  .tomorrow > * + * {
    margin-top: var(--u);
  }
  .days {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px var(--u);
  }
  .checklist {
    padding-block: 2px;
  }
  .last {
    padding-bottom: calc(var(--u) * 3);
  }
  .next-up :global(.nextup) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 20px;
    background: var(--yamabuki);
    border: var(--line) solid var(--ink);
    border-radius: var(--r-card);
    text-decoration: none;
  }
</style>

<script>
  import { dayItems, itemLabel } from '../lib/plan';
  import { daysBetween, jstNow } from '../lib/time';
  import { onLang, t } from '../scripts/lang';
  import { getPlan, subscribe } from '../scripts/store';
  import { renderTimeline } from '../scripts/timeline';
  import { html, mount, placeView } from '../scripts/ui';
  import { wireChecklists, wireDayHeadlines, wireFeeds } from '../scripts/widgets';
  import { wireCopyButtons } from '../scripts/device';

  wireDayHeadlines();
  wireChecklists();
  wireFeeds();
  wireCopyButtons();

  const today = jstNow().date;

  // "Next up": the next timed thing today, from the shared plan.
  for (const el of document.querySelectorAll<HTMLElement>('[data-next-up]')) {
    const day = el.dataset.nextUp!;
    if (day !== today) continue;
    mount(el, () => {
      const plan = getPlan();
      const now = jstNow();
      const hhmm = `${String(Math.floor(now.minutes / 60)).padStart(2, '0')}:${String(now.minutes % 60).padStart(2, '0')}`;
      const next = dayItems(plan, day).timed.find((i) => i.time! >= hhmm);
      if (!next) return html``;
      const place = placeView(plan, next.place);
      return html`<a class="nextup" href="${place?.href ?? `/day/${day}/`}">
        <span class="t13">${t('today.nextUp')}</span>
        <span class="t28"><span class="num">${next.time}</span> ${itemLabel(plan, next)}</span>
        ${place?.nameJa ? html`<span class="t20" lang="ja">${place.nameJa}</span>` : ''}
        ${next.note ? html`<span>${next.note}</span>` : ''}
      </a>`;
    });
  }

  // Today's timeline, read-only; changes happen on the day's page.
  for (const el of document.querySelectorAll<HTMLElement>('[data-today-timeline]')) {
    const day = el.dataset.todayTimeline!;
    if (day !== today) continue;
    let first = true;
    mount(el, () => {
      const out = renderTimeline(getPlan(), day, { editable: false, enter: first });
      first = false;
      return out;
    });
  }

  function render() {
    const plan = getPlan();
    const dayCards = [...document.querySelectorAll<HTMLElement>('[data-day]')];
    const first = dayCards[0]?.dataset.day ?? today;
    const last = dayCards[dayCards.length - 1]?.dataset.day ?? today;
    const view = today < first ? 'before' : today > last ? 'after' : 'during';

    for (const el of document.querySelectorAll<HTMLElement>('[data-view]')) el.hidden = el.dataset.view !== view;
    for (const card of dayCards) card.hidden = card.dataset.day !== today;

    const pill = document.querySelector<HTMLElement>('[data-hero-pill]')!;
    if (view === 'during') {
      pill.textContent = t('hero.dayOf', { n: dayCards.findIndex((c) => c.dataset.day === today) + 1, m: dayCards.length });
      pill.classList.replace('yamabuki', 'coral');
    } else if (view === 'after') pill.textContent = t('hero.home');
    else {
      const n = daysBetween(today, first);
      pill.textContent = n === 1 ? t('hero.countdown1') : t('hero.countdown', { n });
    }
    if (view !== 'before') return;

    // Book next: hide windows that have passed and anything already done.
    let done = 0;
    for (const li of document.querySelectorAll<HTMLElement>('[data-booking-date]')) {
      const key = li.querySelector<HTMLInputElement>('[data-check]')!.dataset.check!;
      const date = li.dataset.bookingDate;
      const d = date ? daysBetween(today, date) : null;
      const isDone = Boolean(plan.checks[key]);
      if (isDone) done++;
      li.hidden = isDone || (d !== null && d < 0);
      const rel = li.querySelector('[data-relative]');
      if (rel && d !== null) rel.textContent = d === 0 ? t('rel.today') : d === 1 ? t('rel.tomorrow') : d > 0 ? t('rel.inDays', { n: d }) : '';
    }
    const doneNote = document.querySelector<HTMLElement>('[data-done-note]')!;
    doneNote.hidden = !done;
    doneNote.textContent = t('today.doneNote', { n: done });

    for (const li of document.querySelectorAll<HTMLElement>('[data-prep-due]')) {
      const due = li.dataset.prepDue ?? '';
      const key = li.querySelector<HTMLInputElement>('[data-check]')!.dataset.check!;
      li.hidden = Boolean(plan.checks[key]) || (/^\d{4}-/.test(due) && due < today);
    }
  }

  render();
  subscribe(render);
  onLang(render);
</script>
