---
import Base from '../../layouts/Base.astro';
import U from '../../components/U.astro';
import { KINDS, loadData } from '../../lib/data';
import { dateIn, KIND_LABEL, ui, type UIKey } from '../../i18n/ui';

const data = await loadData();
const ph = (key: UIKey) => ({ 'data-ph-en': ui(key, 'en'), 'data-ph-zh': ui(key, 'zh'), placeholder: ui(key, 'en') });
const both = (en: string, zh: string) => ({ 'data-text-en': en, 'data-text-zh': zh });
---

<Base title={ui('add.title', 'en')} titleZh={ui('add.title', 'zh')} tab="places">
  <nav class="wrap back" aria-label="Back">
    <a href="/places/eat/" data-back><span data-back-label><U k="add.back" /></span></a>
  </nav>
  <header class="page-head">
    <h1 class="t40 w700"><U k="add.title" /></h1>
    <p class="muted"><U k="add.sub" /></p>
  </header>

  <form class="wrap addform" data-add-place>
    <label class="field">
      <span><U k="add.name" /></span>
      <input type="text" name="name" required maxlength="120" autocomplete="off" {...ph('add.namePh')} />
    </label>
    <label class="field">
      <span><U k="add.nameJaOpt" /></span>
      <input type="text" name="name_ja" maxlength="120" lang="ja" autocomplete="off" />
      <small class="t13 muted"><U k="add.nameJaHint" /></small>
    </label>
    <label class="field">
      <span><U k="add.addressOpt" /></span>
      <input type="text" name="address" maxlength="200" autocomplete="off" />
      <small class="t13 muted"><U k="add.addressHint" /></small>
    </label>
    <label class="field">
      <span><U k="add.mapsOpt" /></span>
      <input type="url" name="maps" maxlength="600" inputmode="url" autocomplete="off" placeholder="https://maps.app.goo.gl/…" />
      <small class="t13 muted"><U k="add.mapsHint" /></small>
    </label>
    <label class="field">
      <span><U k="add.kind" /></span>
      <select name="kind">
        {KINDS.map((k) => <option value={k.id} {...both(KIND_LABEL[k.id][0], KIND_LABEL[k.id][1])}>{KIND_LABEL[k.id][0]}</option>)}
      </select>
    </label>
    <label class="field">
      <span><U k="add.noteOpt" /></span>
      <textarea name="note" rows="3" maxlength="500" {...ph('add.notePh')}></textarea>
    </label>
    <div class="row2">
      <label class="field">
        <span><U k="add.day" /></span>
        <select name="day">
          <option value="" {...both(ui('add.notYet', 'en'), ui('add.notYet', 'zh'))}>{ui('add.notYet', 'en')}</option>
          {
            data.days.map((d) => {
              const en = `${dateIn(d.date, 'en')} · ${d.title}`;
              const zh = `${dateIn(d.date, 'zh')} · ${data.zh.days[d.date]?.title ?? d.title}`;
              return (
                <option value={d.date} {...both(en, zh)}>
                  {en}
                </option>
              );
            })
          }
        </select>
      </label>
      <label class="field"><span><U k="add.time" /></span><input type="time" name="time" /></label>
    </div>
    <button class="btn primary" type="submit"><U k="add.submit" /></button>
    <p class="t13 w500" data-status aria-live="polite"></p>
  </form>
</Base>

<style>
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-top: var(--u);
    font-weight: 500;
  }
  .page-head p {
    margin-top: var(--u);
  }
  .addform {
    padding-bottom: calc(var(--u) * 5);
  }
  .addform .btn {
    margin-top: calc(var(--u) * 3);
  }
  small {
    display: block;
    margin-top: 4px;
  }
</style>

<script>
  import { KIND_IDS } from '../../lib/catalog';
  import { ui } from '../../i18n/ui';
  import { t } from '../../scripts/lang';
  import { dispatch, newId } from '../../scripts/store';
  import { html } from '../../scripts/ui';

  const form = document.querySelector<HTMLFormElement>('[data-add-place]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  const params = new URLSearchParams(location.search);
  const kind = params.get('kind');
  const day = params.get('day');
  if (kind) (form.elements.namedItem('kind') as HTMLSelectElement).value = kind;
  if (day) {
    (form.elements.namedItem('day') as HTMLSelectElement).value = day;
    document.querySelector<HTMLAnchorElement>('[data-back]')!.href = `/day/${day}/`;
    document.querySelector<HTMLElement>('[data-back-label]')!.innerHTML = html`<span data-l="en">${ui('add.backDay', 'en')}</span><span data-l="zh" lang="zh-Hant">${ui('add.backDay', 'zh')}</span>`.value;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) ?? '').trim() || null;
    const id = newId('m-');
    const error = dispatch({
      type: 'place.add',
      id,
      name: value('name') ?? '',
      name_ja: value('name_ja'),
      address: value('address'),
      maps: value('maps'),
      kind: KIND_IDS.find((k) => k === data.get('kind')) ?? 'eat',
      note: value('note'),
    });
    if (error) {
      status.textContent = t('sync.notSaved', { reason: error });
      return;
    }
    const chosenDay = value('day');
    if (chosenDay) {
      const planError = dispatch({ type: 'item.add', id: newId(), day: chosenDay, time: value('time'), place: id });
      if (planError) status.textContent = t('sync.notSaved', { reason: planError });
    }
    location.href = `/p/mine/?id=${id}`;
  });
</script>
