---
import Base from '../../layouts/Base.astro';
import DayCard from '../../components/DayCard.astro';
import DayTrack from '../../components/DayTrack.astro';
import SectionHead from '../../components/SectionHead.astro';
import StationBadge from '../../components/StationBadge.astro';
import T from '../../components/T.astro';
import U from '../../components/U.astro';
import { loadData } from '../../lib/data';
import { dateIn, ui } from '../../i18n/ui';

export async function getStaticPaths() {
  const data = await loadData();
  return data.days.map((d) => ({ params: { date: d.date } }));
}

const data = await loadData();
const date = Astro.params.date!;
const index = data.days.findIndex((d) => d.date === date);
const day = data.days[index];
const zh = data.zh.days[date];
const ideas = day.places.map((id) => data.place(id));
const ph = (key: Parameters<typeof ui>[0]) => ({ 'data-ph-en': ui(key, 'en'), 'data-ph-zh': ui(key, 'zh'), placeholder: ui(key, 'en') });
---

<Base
  title={`${dateIn(date, 'en')} · ${day.title}`}
  titleZh={`${dateIn(date, 'zh')} · ${zh?.title ?? day.title}`}
  tab="plan"
>
  <div class="section top">
    <SectionHead icon="train" tone="coral"><U k="itin.title" /></SectionHead>
    <DayTrack days={data.days} current={date} />
    <div class="enter" style="--i: 0">
      <DayCard day={day} n={index + 1} zh={zh} stay={data.stay} flights={data.flights} level={1} />
    </div>
    <p class="anchor enter" style="--i: 1">
      <span class="label"><U k="day.mainPlan" /></span>
      <span data-day-anchor={date}><T en={day.anchor} zh={zh?.anchor} /></span>
    </p>
    <details class="headline-edit" data-headline={date}>
      <summary class="linkish"><U k="day.editHeadline" /></summary>
      <form data-form="headline">
        <label class="field"><span><U k="day.title" /></span><input type="text" name="title" maxlength="80" /></label>
        <label class="field"><span><U k="day.mainPlan" /></span><textarea name="anchor" maxlength="240" rows="3"></textarea></label>
        <div class="btn-row">
          <button class="btn small primary" type="submit"><U k="common.save" /></button>
          <button class="btn small" type="button" data-reset><U k="day.reset" /></button>
        </div>
      </form>
    </details>
  </div>

  <section class="section plan" aria-labelledby="plan-h">
    <h2 class="sr-only" id="plan-h"><U k="day.yourPlan" /></h2>
    <div data-day-items={date}></div>
    <p class="btns ask">
      <a class="btn" data-ask-day href="https://claude.ai/new"><U k="day.ask" /> <span class="hint">↗</span></a>
    </p>
  </section>

  <section class="section" aria-labelledby="add-h" data-adder={date}>
    <SectionHead icon="plus" tone="wakatake" id="add-h"><U k="day.add" /></SectionHead>
    <div class="card">
      <label class="field first"><span><U k="day.timeNext" /></span><input type="time" name="time" data-add-time /></label>
      <label class="field">
        <span><U k="day.find" /></span>
        <input type="search" name="q" autocomplete="off" data-search {...ph('day.findPh')} />
      </label>
      <ul class="picks" data-results></ul>

      <form data-form="custom-item" class="custom">
        <label class="field">
          <span><U k="day.custom" /></span>
          <input type="text" name="title" maxlength="120" {...ph('day.customPh')} />
        </label>
        <button class="btn small" type="submit"><U k="day.addIt" /></button>
      </form>
      <p class="t13 status" data-add-status aria-live="polite"></p>
    </div>
    <p class="btns">
      <a class="btn" href={`/add/?day=${date}`}><U k="day.addUnlisted" /> <span class="hint">→</span></a>
    </p>

    <SectionHead icon="star" tone="coral" level={3} small><U k="day.fromWant" /></SectionHead>
    <ul class="picks" data-wants></ul>

    <SectionHead icon="sparkle" tone="yamabuki" level={3} small><U k="day.ideas" /></SectionHead>
    <ul class="picks">
      {
        ideas.map((p) => (
          <li data-idea={p.id}>
            <a href={`/p/${p.id}/`} class="pick-name">
              <span class="name">{p.name_en}</span>
              {p.name_ja !== p.name_en && <span lang="ja">{p.name_ja}</span>}
              <span class="t13 muted">
                <T en={p.recognition} zh={data.zh.places[p.id]?.recognition} />
              </span>
              <StationBadge line={data.line(p.line)} station={p.station} />
            </a>
            <button type="button" class="chip" data-action="add" data-ref={p.id}>
              <U k="common.add" />
            </button>
          </li>
        ))
      }
    </ul>

    <SectionHead icon="book" tone="mizu" level={3} small><U k="day.notes" /></SectionHead>
    <ul class="notes card">
      {
        day.notes.map((n, j) => (
          <li>
            <T en={n} zh={zh?.notes[j]} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .top > :global(.track) {
    margin-top: var(--u);
  }
  .anchor {
    padding: 0 4px;
  }
  .headline-edit {
    margin-top: 0 !important;
    padding-inline: 4px;
  }
  .headline-edit form {
    padding-bottom: calc(var(--u) * 2);
  }
  .plan {
    padding-top: calc(var(--u) * 2);
  }
  .plan > [data-day-items] {
    margin-top: 0;
  }
  .ask {
    margin-top: calc(var(--u) * 3) !important;
  }
  .first {
    margin-top: 0;
  }
  .custom {
    margin-top: calc(var(--u) * 2);
  }
  .status:empty {
    display: none;
  }
  [data-adder] :global(.sec-head.small) {
    margin-top: calc(var(--u) * 4);
  }
  .notes {
    padding-block: 4px;
  }
  .notes li {
    padding: 12px 0;
  }
  .notes li + li {
    background: radial-gradient(circle, var(--ink) 1.5px, transparent 1.9px) 0 0 / 8px 4px repeat-x;
  }
  section:last-of-type {
    padding-bottom: calc(var(--u) * 5);
  }
</style>

<script>
  import { askAboutDay } from '../../lib/ask';
  import { DAYS, PLACES } from '../../lib/catalog';
  import { type PlanState } from '../../lib/plan';
  import { date as dateLabel, lang, t } from '../../scripts/lang';
  import { dispatch, getPlan, newId, subscribe } from '../../scripts/store';
  import { renderTimeline } from '../../scripts/timeline';
  import { dayHeadline, html, mount, onAction, onForm, placeView } from '../../scripts/ui';
  import { dayLines, wireDayHeadlines } from '../../scripts/widgets';

  const list = document.querySelector<HTMLElement>('[data-day-items]')!;
  const date = list.dataset.dayItems!;
  const adder = document.querySelector<HTMLElement>('[data-adder]')!;
  const status = adder.querySelector<HTMLElement>('[data-add-status]')!;
  const timeInput = adder.querySelector<HTMLInputElement>('[data-add-time]')!;
  const search = adder.querySelector<HTMLInputElement>('[data-search]')!;

  wireDayHeadlines();

  const say = (text: string) => (status.textContent = text);
  const failed = (error: string) => say(t('sync.notSaved', { reason: error }));
  const onThisDay = (plan: PlanState, ref: string) => plan.items.some((i) => i.day === date && i.place === ref);

  // ── Your plan ──────────────────────────────────────────────────────────
  let first = true;
  mount(list, () => {
    const out = html`${renderTimeline(getPlan(), date, { editable: true, enter: first })}<p class="t13 muted legend">${t('day.legend')}</p>`;
    first = false;
    return out;
  });

  onForm(list, {
    item: (form, data) => {
      const error = dispatch({
        type: 'item.update',
        id: form.dataset.id!,
        time: String(data.get('time') ?? '') || null,
        day: String(data.get('day')),
        note: String(data.get('note') ?? ''),
      });
      if (error) failed(error);
      else (form.closest('details') as HTMLDetailsElement).open = false;
    },
  });

  onAction(list, {
    up: (el) => dispatch({ type: 'item.move', id: el.dataset.id!, dir: -1 }),
    down: (el) => dispatch({ type: 'item.move', id: el.dataset.id!, dir: 1 }),
    remove: (el) => {
      // Ask twice instead of a dialog.
      if (el.dataset.armed !== 'true') {
        el.dataset.armed = 'true';
        el.textContent = t('item.removeAgain');
        setTimeout(() => {
          el.dataset.armed = 'false';
          el.textContent = t('item.remove');
        }, 3000);
        return;
      }
      dispatch({ type: 'item.remove', id: el.dataset.id! });
    },
  });

  // "Ask Claude about this day" carries the current plan, in this phone's language.
  const ask = document.querySelector<HTMLAnchorElement>('[data-ask-day]')!;
  const paintAsk = () => {
    const plan = getPlan();
    const lines = dayLines(plan, date).map((l) => `${l.time ?? t('day.anyTime')}: ${l.label}`);
    ask.href = askAboutDay(dateLabel(date), dayHeadline(plan, date).anchor, lines, lang());
  };
  paintAsk();
  subscribe(paintAsk);

  // ── Headline ───────────────────────────────────────────────────────────
  const headline = document.querySelector<HTMLDetailsElement>('[data-headline]')!;
  const original = DAYS.find((d) => d.date === date)!;
  headline.addEventListener('toggle', () => {
    if (!headline.open) return;
    const now = dayHeadline(getPlan(), date);
    (headline.querySelector('[name=title]') as HTMLInputElement).value = now.title;
    (headline.querySelector('[name=anchor]') as HTMLTextAreaElement).value = now.anchor;
  });
  onForm(headline, {
    headline: (_form, data) => {
      const title = String(data.get('title') ?? '').trim();
      const anchor = String(data.get('anchor') ?? '').trim();
      // Unchanged from the research (in either language) means no override.
      const shown = dayHeadline(null, date);
      const keep = (value: string, en: string, current: string) => (value && value !== en && value !== current ? value : null);
      const error = dispatch({
        type: 'day.edit',
        day: date,
        title: keep(title, original.title, shown.title),
        anchor: keep(anchor, original.anchor, shown.anchor),
      });
      if (!error) headline.open = false;
    },
  });
  headline.querySelector('[data-reset]')!.addEventListener('click', () => {
    dispatch({ type: 'day.edit', day: date, title: null, anchor: null });
    headline.open = false;
  });

  // ── Adding ─────────────────────────────────────────────────────────────
  const add = (item: { place?: string; title?: string }) => {
    const time = timeInput.value || null;
    const error = dispatch({ type: 'item.add', id: newId(), day: date, time, ...item });
    if (error) return failed(error);
    timeInput.value = '';
    const label = item.title ?? placeView(getPlan(), item.place ?? null)?.name ?? '';
    say(time ? t('day.addedAt', { label, time }) : t('day.added', { label }));
  };

  onAction(adder, { add: (el) => add({ place: el.dataset.ref! }) });
  onForm(adder, {
    'custom-item': (form, data) => {
      const title = String(data.get('title') ?? '').trim();
      if (!title) return say(t('day.typeFirst'));
      add({ title });
      form.reset();
    },
  });

  const pick = (plan: PlanState, ref: string, name: string, extra: ReturnType<typeof html> | string, href: string) =>
    html`<li><a href="${href}" class="pick-name"><span class="name">${name}</span>${extra}</a>${
      onThisDay(plan, ref)
        ? html`<span class="tag wakatake added">${t('day.onDay')}</span>`
        : html`<button type="button" class="chip" data-action="add" data-ref="${ref}">${t('common.add')}</button>`
    }</li>`;

  // Search the researched places and your own.
  const norm = (s: string) => s.toLowerCase().normalize('NFKC');
  const results = adder.querySelector<HTMLElement>('[data-results]')!;
  const repaintResults = mount(results, () => {
    const q = norm(search.value.trim());
    if (q.length < 1) return html``;
    const plan = getPlan();
    const mine = plan.places.map((p) => ({ ref: p.id, name: p.name, ja: p.name_ja ?? '', where: p.address ?? '', href: `/p/mine/?id=${p.id}` }));
    const listed = PLACES.map((p) => ({ ref: p.id, name: p.name_en, ja: p.name_ja !== p.name_en ? p.name_ja : '', where: p.station, href: `/p/${p.id}/` }));
    const found = [...mine, ...listed]
      .map((p) => {
        const hay = norm(`${p.name} ${p.ja} ${p.where}`);
        const score = norm(p.name).startsWith(q) || norm(p.ja).startsWith(q) ? 0 : hay.includes(q) ? 1 : 2;
        return { p, score };
      })
      .filter((x) => x.score < 2)
      .sort((a, b) => a.score - b.score)
      .slice(0, 8);
    if (!found.length) return html`<li class="muted">${t('day.noMatch')}</li>`;
    return html`${found.map(({ p }) =>
      pick(plan, p.ref, p.name, html`${p.ja ? html`<span lang="ja">${p.ja}</span>` : ''}<span class="t13 muted">${p.where}</span>`, p.href),
    )}`;
  });
  search.addEventListener('input', repaintResults);

  // Want list, minus what's already on this day.
  mount(adder.querySelector<HTMLElement>('[data-wants]')!, () => {
    const plan = getPlan();
    const wants = Object.entries(plan.marks)
      .filter(([ref, m]) => m.mark === 'want' && !onThisDay(plan, ref))
      .map(([ref]) => placeView(plan, ref))
      .filter((v) => v !== null);
    if (!wants.length) return html`<li class="muted">${t('day.wantsEmpty')}</li>`;
    return html`${wants.map((v) => pick(plan, v.ref, v.name, v.nameJa ? html`<span lang="ja">${v.nameJa}</span>` : '', v.href))}`;
  });

  // Ideas: swap Add for "On this day" once added (and follow the language).
  const paintIdeas = () => {
    const plan = getPlan();
    for (const li of adder.querySelectorAll<HTMLElement>('[data-idea]')) {
      const ref = li.dataset.idea!;
      li.querySelector('[data-action=add], .added')?.remove();
      li.insertAdjacentHTML(
        'beforeend',
        onThisDay(plan, ref)
          ? html`<span class="tag wakatake added">${t('day.onDay')}</span>`.value
          : html`<button type="button" class="chip" data-action="add" data-ref="${ref}">${t('common.add')}</button>`.value,
      );
    }
  };
  paintIdeas();
  subscribe(paintIdeas);
</script>
