---
import Base from '../layouts/Base.astro';
import U from '../components/U.astro';
import { ui } from '../i18n/ui';
---

<Base title={ui('nf.short', 'en')} titleZh={ui('nf.short', 'zh')}>
  <header class="page-head">
    <h1 class="t40 w700"><U k="nf.title" /></h1>
  </header>
  <div class="wrap stack">
    <p class="t20"><U k="nf.text" /></p>
    <p><a class="btn" href="/"><U k="nf.today" /></a></p>
    <p><a class="btn" href="/places/eat/"><U k="nf.places" /></a></p>
  </div>
</Base>
