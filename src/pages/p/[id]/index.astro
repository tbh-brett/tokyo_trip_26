---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import StationBadge from '../../../components/StationBadge.astro';
import T from '../../../components/T.astro';
import U from '../../../components/U.astro';
import { loadData, mapsPlaceUrl, mapsTransitUrlFor } from '../../../lib/data';
import { askAboutPlace } from '../../../lib/ask';
import { MARKS } from '../../../lib/plan';
import { closedText, hoursText } from '../../../lib/time';
import { KIND_LABEL, MARK_TEXT, SLOT_TEXT, ui } from '../../../i18n/ui';

export async function getStaticPaths() {
  const data = await loadData();
  return data.places.map((p) => ({ params: { id: p.id } }));
}

const data = await loadData();
const p = data.place(Astro.params.id!);
const zh = data.zh.places[p.id] ?? {};
const line = data.line(p.line);
const zone = data.zone(p.zone);
const zoneZh = data.zh.zones[p.zone];
const sourceIsUrl = /^https?:\/\//.test(p.source);
const [kindEn, kindZh] = KIND_LABEL[p.kind];
const slots = (lang: 0 | 1) => p.slots.map((s) => SLOT_TEXT[s][lang]).join(ui('list.sep', lang ? 'zh' : 'en'));
const addressNote = p.address_precision === 'district' ? 'addr.district' : p.address_verified ? null : 'addr.unchecked';
const ask = (lang: 'en' | 'zh') =>
  askAboutPlace({ name: p.name_en, nameJa: p.name_ja, address: p.address_ja, why: lang === 'zh' ? (zh.why ?? p.why) : p.why }, lang);
---

<Base title={p.name_en} tab="places">
  <nav class="wrap back" aria-label="Back">
    <a href={`/places/${p.kind}/`}><U k="place.all" v={{ kind: kindEn }} vz={{ kind: kindZh }} /></a>
  </nav>

  <header class="page-head head">
    <h1>
      <span class="t28">{p.name_en}</span>
      {p.name_ja !== p.name_en && <span class="t20" lang="ja">{p.name_ja}</span>}
    </h1>
    <p class="tags">
      <span class="tag yamabuki"><T en={p.recognition} zh={zh.recognition} /></span>
      {p.book_ahead && <span class="tag coral"><U k="row.bookAhead" /></span>}
    </p>
  </header>

  <div class="wrap stack">
    <p class="t20"><T en={p.why} zh={zh.why} /></p>
    {
      p.note && (
        <div class="card tint">
          <span class="label">
            <U k="place.note" />
          </span>
          <p>
            <T en={p.note} zh={zh.note} />
          </p>
        </div>
      )
    }
  </div>

  <div class="wrap btns actions">
    <a class="btn primary" href={`/p/${p.id}/staff/`}>
      <U k="place.staff" /> <span class="hint"><U k="place.fullScreen" /></span>
    </a>
    <a class="btn" href={mapsPlaceUrl(p)}>
      <U k="place.maps" /> <span class="hint" aria-hidden="true">↗</span>
    </a>
    <a class="btn" href={mapsTransitUrlFor(p)}>
      <U k="place.directions" /> <span class="hint"><U k="place.transit" /></span>
    </a>
    <button class="btn" type="button" data-copy={p.address_ja}>
      <U k="place.copy" /> <span class="hint" data-copy-status aria-live="polite"></span>
    </button>
    <a class="btn" data-l="en" href={ask('en')}>{ui('place.ask', 'en')} <span class="hint">↗</span></a>
    <a class="btn" data-l="zh" lang="zh-Hant" href={ask('zh')}>{ui('place.ask', 'zh')} <span class="hint">↗</span></a>
  </div>

  <section class="section" aria-labelledby="mark-h">
    <SectionHead icon="star" tone="coral" id="mark-h" small><U k="place.markFor" /></SectionHead>
    <div>
      <div class="seg" role="group" aria-labelledby="mark-h" data-marks={p.id}>
        {
          MARKS.map((m) => (
            <button type="button" data-mark={m} aria-pressed="false">
              <T en={MARK_TEXT[m][0]} zh={MARK_TEXT[m][1]} />
            </button>
          ))
        }
      </div>
      <p class="t13 muted by" data-mark-by></p>
    </div>
  </section>

  <section class="section" aria-labelledby="inplan-h">
    <SectionHead icon="calendar" tone="mizu" id="inplan-h" small><U k="place.inPlan" /></SectionHead>
    <div class="card">
      <div data-in-plan={p.id}></div>
      <form class="addplan" data-add-to-plan={p.id}>
        <div class="row2">
          <label class="field"><span><U k="item.day" /></span><select name="day"></select></label>
          <label class="field"><span><U k="place.timeOpt" /></span><input type="time" name="time" /></label>
        </div>
        <button class="btn small primary" type="submit"><U k="place.addToPlan" /></button>
        <p class="t13" data-status aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="section last">
    <dl class="facts">
      <div
        hidden={p.hours.length === 0}
        data-place={p.id}
        data-hours={JSON.stringify(p.hours)}
        data-closed={p.closed_days.join(',')}
        data-verified={String(p.hours_verified)}
      >
        <dt><U k="fact.now" /></dt>
        <dd><span class="tag" data-open><U k={p.hours_verified ? 'fact.nowHintVerified' : 'fact.nowHint'} /></span></dd>
      </div>
      <div>
        <dt><U k="fact.hours" /></dt>
        <dd class="num">{p.hours.length ? hoursText(p.hours) : <U k="hours.notListed" />}</dd>
        {closedText(p.closed_days) && <dd><T en={closedText(p.closed_days, 'en')} zh={closedText(p.closed_days, 'zh')} /></dd>}
        {p.hours.length === 0 ? (
          <dd class="t13 warn"><U k="hours.checkMaps" /></dd>
        ) : (
          !p.hours_verified && <dd class="t13 muted"><U k="hours.estimated" /></dd>
        )}
      </div>
      <div>
        <dt><U k="fact.price" /></dt>
        <dd class="num"><T en={p.price} zh={zh.price} /></dd>
      </div>
      <div>
        <dt><U k="fact.station" /></dt>
        <dd><StationBadge line={line} station={p.station} /></dd>
      </div>
      <div>
        <dt><U k="fact.area" /></dt>
        <dd><T en={zone.name_en} zh={zoneZh?.full} /></dd>
        <dd lang="ja" data-l={zoneZh ? 'en' : undefined}>{zone.name_ja}</dd>
      </div>
      <div>
        <dt><U k="fact.address" /></dt>
        <dd lang="ja">{p.address_ja}</dd>
        {addressNote && <dd class="t13 muted"><U k={addressNote} /></dd>}
      </div>
      <div>
        <dt><U k="fact.goodFor" /></dt>
        <dd><T en={slots(0)} zh={slots(1)} /></dd>
      </div>
      <div>
        <dt><U k="fact.source" /></dt>
        <dd class="t13">
          {sourceIsUrl ? <a href={p.source}>{p.source}</a> : p.source === 'general-knowledge' ? <U k="fact.generalKnowledge" /> : p.source}
        </dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    margin-top: var(--u);
  }
  .head h1 > span {
    display: block;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .actions {
    margin-top: calc(var(--u) * 3);
  }
  .by {
    margin-top: 6px;
  }
  .addplan {
    margin-top: var(--u);
  }
  .last {
    padding-bottom: calc(var(--u) * 3);
  }
</style>

<script>
  import { wireCopyButtons } from '../../../scripts/device';
  import { wireAddToPlan, wireMarks, wirePlaceRows } from '../../../scripts/widgets';

  wirePlaceRows(); // the "Now" line
  wireMarks();
  wireAddToPlan();
  wireCopyButtons();
</script>
