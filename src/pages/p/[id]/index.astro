---
import Base from '../../../layouts/Base.astro';
import StationBadge from '../../../components/StationBadge.astro';
import { kindLabel, loadData, mapsPlaceUrl, mapsTransitUrl } from '../../../lib/data';
import { MARKS, MARK_LABEL } from '../../../lib/marks';
import { closedText, hoursText } from '../../../lib/time';

export async function getStaticPaths() {
  const data = await loadData();
  return data.places.map((p) => ({ params: { id: p.id } }));
}

const data = await loadData();
const p = data.place(Astro.params.id!);
const line = data.line(p.line);
const zone = data.zone(p.zone);
const sourceIsUrl = /^https?:\/\//.test(p.source);

const addressNote =
  p.address_precision === 'district'
    ? 'Neighbourhood only. The street address is not known yet, so Maps may land on the area, not the door.'
    : p.address_verified
      ? null
      : 'Street address, not yet checked.';
---

<Base title={p.name_en} tab="places">
  <nav class="wrap back" aria-label="Back">
    <a href={`/places/${p.kind}/`}>← All {kindLabel(p.kind)}</a>
  </nav>

  <header class="page-head head">
    <h1 class="t28 w700">
      <span>{p.name_en}</span>
      {p.name_ja !== p.name_en && <span lang="ja">{p.name_ja}</span>}
    </h1>
    <p class="t20 w500">{p.recognition}</p>
  </header>

  <div class="wrap stack">
    <p class="t20">{p.why}</p>
    {
      p.note && (
        <p class="note">
          <span class="label">Note</span>
          {p.note}
        </p>
      )
    }
  </div>

  <div class="wrap btns actions">
    <a class="btn primary" href={`/p/${p.id}/staff/`}>
      Show to staff <span class="hint">Full screen</span>
    </a>
    <a class="btn" href={mapsPlaceUrl(p)}>
      Open in Google Maps <span class="hint" aria-hidden="true">↗</span>
    </a>
    <a class="btn" href={mapsTransitUrl(p)}>
      Directions from here <span class="hint">Transit ↗</span>
    </a>
    <button class="btn" type="button" data-copy={p.address_ja}>
      Copy address <span class="hint" data-copy-status aria-live="polite"></span>
    </button>
  </div>

  <div class="wrap marks">
    <span class="label" id="mark-label">Mark on this phone</span>
    <div class="seg" role="group" aria-labelledby="mark-label" data-marks={p.id}>
      {
        MARKS.map((m) => (
          <button type="button" data-mark={m} aria-pressed="false">
            {MARK_LABEL[m]}
          </button>
        ))
      }
    </div>
  </div>

  <dl class="wrap facts">
    <div
      data-place={p.id}
      data-hours={JSON.stringify(p.hours)}
      data-closed={p.closed_days.join(',')}
      data-verified={String(p.hours_verified)}
    >
      <dt>Now</dt>
      <dd class="w500" data-open>{p.hours_verified ? 'Open hours below' : 'See estimated hours below'}</dd>
    </div>
    <div>
      <dt>Hours</dt>
      <dd class="mono">{hoursText(p.hours)}</dd>
      {closedText(p.closed_days) && <dd>{closedText(p.closed_days)}</dd>}
      {!p.hours_verified && <dd class="t13 muted">Estimated. Not yet checked with the shop.</dd>}
    </div>
    <div>
      <dt>Price</dt>
      <dd class="mono">{p.price}</dd>
    </div>
    {
      p.book_ahead && (
        <div>
          <dt>Booking</dt>
          <dd class="w500">Book ahead</dd>
        </div>
      )
    }
    <div>
      <dt>Station</dt>
      <dd><StationBadge line={line} station={p.station} /></dd>
    </div>
    <div>
      <dt>Area</dt>
      <dd>{zone.name_en}</dd>
      <dd lang="ja">{zone.name_ja}</dd>
    </div>
    <div>
      <dt>Address</dt>
      <dd lang="ja">{p.address_ja}</dd>
      {addressNote && <dd class="t13 muted">{addressNote}</dd>}
    </div>
    <div>
      <dt>Good for</dt>
      <dd>{p.slots.join(', ')}</dd>
    </div>
    <div>
      <dt>Source</dt>
      <dd class="t13">{sourceIsUrl ? <a href={p.source}>{p.source}</a> : p.source}</dd>
    </div>
  </dl>
</Base>

<style>
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-top: var(--u);
    font-weight: 500;
  }
  .head {
    padding-top: var(--u);
  }
  .head h1 span {
    display: block;
  }
  .head p {
    margin-top: var(--u);
  }
  .note .label {
    margin-bottom: 4px;
  }
  .actions {
    margin-top: calc(var(--u) * 3);
  }
  .marks {
    margin-top: calc(var(--u) * 3);
  }
  .marks .label {
    margin-bottom: var(--u);
  }
  .facts {
    margin-top: calc(var(--u) * 3);
    padding-bottom: calc(var(--u) * 4);
  }
  .facts > div:first-child {
    border-top: 1px solid var(--ink);
  }
</style>

<script>
  import { readMarks, writeMark, type Mark } from '../../../lib/marks';
  import { watchRows } from '../../../scripts/rows';

  watchRows();

  // Want / Booked / Skip: tap again to clear.
  const group = document.querySelector<HTMLElement>('[data-marks]');
  if (group) {
    const id = group.dataset.marks!;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
    const show = (mark: Mark | undefined) => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.mark === mark));
    };
    show(readMarks()[id]);
    for (const b of buttons) {
      b.addEventListener('click', () => {
        const next = b.getAttribute('aria-pressed') === 'true' ? null : (b.dataset.mark as Mark);
        writeMark(id, next);
        show(next ?? undefined);
      });
    }
  }

  // Copy address, with a fallback for browsers without the async clipboard.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  copy?.addEventListener('click', async () => {
    const text = copy.dataset.copy ?? '';
    let ok = false;
    try {
      await navigator.clipboard.writeText(text);
      ok = true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      try {
        // Deprecated, but still the only copy path on older iOS Safari.
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      area.remove();
    }
    if (status) status.textContent = ok ? 'Copied' : 'Press and hold the address below';
  });
</script>
