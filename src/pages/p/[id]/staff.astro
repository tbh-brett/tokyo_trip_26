---
// Show to staff: the one centred screen. White on black, Japanese name large.
import Base from '../../../layouts/Base.astro';
import U from '../../../components/U.astro';
import { ui } from '../../../i18n/ui';
import { loadData } from '../../../lib/data';

export async function getStaticPaths() {
  const data = await loadData();
  return data.places.map((p) => ({ params: { id: p.id } }));
}

const data = await loadData();
const p = data.place(Astro.params.id!);
---

<Base title={ui('staff.title', 'en', { name: p.name_en })} titleZh={ui('staff.title', 'zh', { name: p.name_en })} showTabs={false} bodyClass="staff">
  <a class="close" href={`/p/${p.id}/`}><U k="staff.close" /></a>
  <div class="card">
    <p class="ja" lang="ja">{p.name_ja}</p>
    <p class="addr" lang="ja">{p.address_ja}</p>
    {p.name_en !== p.name_ja && <p class="en">{p.name_en}</p>}
  </div>
</Base>

<style is:global>
  body.staff {
    background: #000;
    color: #fff;
    padding-bottom: 0;
    color-scheme: dark;
  }
</style>

<style>
  .close {
    position: absolute;
    top: env(safe-area-inset-top);
    left: 0;
    display: inline-flex;
    align-items: center;
    min-height: 56px;
    padding-inline: var(--g);
    color: #fff;
    font-weight: 500;
    font-size: var(--t20);
    text-decoration: none;
  }
  .close:focus-visible {
    outline-color: #fff;
  }
  .card {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 3);
    padding: 72px var(--g) calc(var(--u) * 5);
    text-align: center;
  }
  .ja {
    font-size: clamp(48px, 13vw, 96px);
    line-height: 1.2;
    font-weight: 700;
    overflow-wrap: anywhere;
    word-break: auto-phrase;
  }
  .addr {
    font-size: var(--t28);
    line-height: 1.4;
    font-weight: 500;
  }
  .en {
    font-size: var(--t20);
    color: #bdbdbd;
  }
</style>

<script>
  import { holdScreenOn } from '../../../scripts/device';

  // Keep the screen on while it's being shown. Refusal is fine; nothing breaks.
  holdScreenOn();
</script>
