---
// Show to staff: the one centred screen. Washi on ink, Japanese name large.
import Base from '../../../layouts/Base.astro';
import U from '../../../components/U.astro';
import { ui } from '../../../i18n/ui';
import { loadData } from '../../../lib/data';

export async function getStaticPaths() {
  const data = await loadData();
  return data.places.map((p) => ({ params: { id: p.id } }));
}

const data = await loadData();
const p = data.place(Astro.params.id!);
---

<Base title={ui('staff.title', 'en', { name: p.name_en })} titleZh={ui('staff.title', 'zh', { name: p.name_en })} showTabs={false} bodyClass="staff">
  <a class="staff-close" href={`/p/${p.id}/`}><U k="staff.close" /></a>
  <div class="staff-card">
    <p class="staff-ja" lang="ja">{p.name_ja}</p>
    <p class="staff-addr" lang="ja">{p.address_ja}</p>
    {p.name_en !== p.name_ja && <p class="staff-en">{p.name_en}</p>}
  </div>
</Base>

<script>
  import { holdScreenOn } from '../../../scripts/device';

  // Keep the screen on while it's being shown. Refusal is fine; nothing breaks.
  holdScreenOn();
</script>
