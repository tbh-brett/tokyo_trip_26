---
// Show to staff for your own places (/p/mine/staff/?id=…).
import Base from '../../../layouts/Base.astro';
import U from '../../../components/U.astro';
import { ui } from '../../../i18n/ui';
---

<Base title={ui('place.staff', 'en')} titleZh={ui('place.staff', 'zh')} showTabs={false} bodyClass="staff">
  <a class="staff-close" href="/plan/" data-close><U k="staff.close" /></a>
  <div class="staff-card">
    <p class="staff-ja" lang="ja" data-f="ja"></p>
    <p class="staff-addr" lang="ja" data-f="address"></p>
    <p class="staff-en" data-f="en"></p>
  </div>
</Base>

<script>
  import { holdScreenOn } from '../../../scripts/device';
  import { t } from '../../../scripts/lang';
  import { getPlan } from '../../../scripts/store';

  // No live sync on this screen: the plan as this phone has it, unsent changes included.
  const plan = getPlan();
  const id = new URLSearchParams(location.search).get('id') ?? '';
  const place = plan.places.find((p) => p.id === id);
  const set = (name: string, text: string) => (document.querySelector(`[data-f="${name}"]`)!.textContent = text);
  if (place) {
    set('ja', place.name_ja ?? place.name);
    set('address', place.address ?? '');
    set('en', place.name_ja ? place.name : '');
    document.querySelector<HTMLAnchorElement>('[data-close]')!.href = `/p/mine/?id=${place.id}`;
  } else set('en', t('mine.notOnPhone'));
  holdScreenOn();
</script>
