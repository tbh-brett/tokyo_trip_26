---
import '../styles/fonts.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import U from '../components/U.astro';
import { ui } from '../i18n/ui';

interface Props {
  /** Page title in English, and in Chinese if it differs. */
  title: string;
  titleZh?: string;
  /** Which tab is current, if any. */
  tab?: 'today' | 'plan' | 'places';
  /** false hides the tab bar and live sync (Show to staff). */
  showTabs?: boolean;
  bodyClass?: string;
}

const { title, titleZh, tab, showTabs = true, bodyClass } = Astro.props;
const full = (t: string, app: string) => (t === app ? t : `${t} · ${app}`);
const titleEn = full(title, ui('appName', 'en'));
const titleZhFull = full(titleZh ?? title, ui('appName', 'zh'));
const tabs = [
  { id: 'today', key: 'tab.today', href: '/' },
  { id: 'plan', key: 'tab.plan', href: '/plan/' },
  { id: 'places', key: 'tab.places', href: '/places/eat/' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- The site is behind Cloudflare Access, so the manifest must be fetched with the login cookie. -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Tokyo" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="title-en" content={titleEn} />
    <meta name="title-zh" content={titleZhFull} />
    <title>{titleEn}</title>
    <!-- Pick this phone's language before anything paints. Same key as src/scripts/lang.ts. -->
    <script is:inline>
      try {
        if (localStorage.getItem('tokyo2026:lang') === 'zh') {
          document.documentElement.dataset.lang = 'zh';
          document.documentElement.lang = 'zh-Hant';
          document.title = document.querySelector('meta[name="title-zh"]').content;
        }
      } catch (e) {}
    </script>
  </head>
  <body class={bodyClass} data-live={showTabs ? 'on' : 'off'}>
    <a class="skip" href="#main"><U k="skip" /></a>
    {showTabs && <div class="whoami" data-whoami hidden />}
    <main id="main">
      <slot />
    </main>
    {
      showTabs && (
        <>
          <div class="syncbar" data-syncbar role="status" hidden />
          <nav class="tabbar" aria-label="Sections">
            {tabs.map((t) => (
              <a href={t.href} aria-current={t.id === tab ? 'page' : undefined}>
                <U k={t.key} />
              </a>
            ))}
            <button
              type="button"
              class="langbtn"
              data-lang-toggle
              aria-label={ui('lang.switch', 'en')}
              data-aria-en={ui('lang.switch', 'en')}
              data-aria-zh={ui('lang.switch', 'zh')}
            >
              <span data-l="en" lang="zh-Hant">{ui('lang.other', 'en')}</span>
              <span data-l="zh" lang="en">{ui('lang.other', 'zh')}</span>
            </button>
          </nav>
        </>
      )
    }
  </body>
</html>

<script>
  import { activityText } from '../lib/activity';
  import { TRAVELLERS } from '../lib/catalog';
  import { applyLang, lang, onLang, setLang, t } from '../scripts/lang';
  import { dismiss, getNews, getSync, me, refresh, setMe, start, subscribe } from '../scripts/store';
  import { html } from '../scripts/ui';

  applyLang();

  // Save the whole site on the phone for no-signal use (scripts/build-sw.mjs).
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});

  // The language button in the tab bar.
  document.querySelector('[data-lang-toggle]')?.addEventListener('click', () => setLang(lang() === 'zh' ? 'en' : 'zh'));
  onLang(refresh);

  if (document.body.dataset.live === 'on') {
    start();

    // Status line above the tabs: saving, no signal, errors, and the other phone's news.
    const bar = document.querySelector<HTMLElement>('[data-syncbar]')!;
    let savingSince = 0;
    const paintBar = () => {
      const s = getSync();
      const news = getNews();
      let text = '';
      let tone = '';
      let button = '';
      if (s.kind === 'saving') {
        savingSince ||= Date.now();
        // Only mention saving if it's taking a moment.
        if (Date.now() - savingSince > 800) text = t('sync.saving');
        else setTimeout(paintBar, 900);
      } else savingSince = 0;
      if (s.kind === 'offline') {
        const since = s.since ? new Date(s.since).toTimeString().slice(0, 5) : null;
        text = s.waiting
          ? s.waiting === 1
            ? t('sync.waiting1')
            : t('sync.waitingN', { n: s.waiting })
          : since
            ? t('sync.asOf', { time: since })
            : t('sync.notYet');
      } else if (s.kind === 'signin') {
        text = t('sync.expired');
        button = 'signin';
        tone = 'alert';
      } else if (s.kind === 'error') {
        text = s.message;
        button = 'dismiss';
        tone = 'alert';
      } else if (s.kind === 'live' && news) {
        text = `${news.act.by} ${activityText(news.act, lang())}`;
        button = 'dismiss';
        tone = 'news';
      }
      bar.hidden = !text;
      bar.dataset.tone = tone;
      document.body.classList.toggle('has-syncbar', Boolean(text));
      bar.innerHTML = html`<span>${text}</span>${
        button === 'signin'
          ? html`<button type="button" data-bar="signin">${t('sync.signIn')}</button>`
          : button === 'dismiss'
            ? html`<button type="button" data-bar="dismiss">${t('sync.ok')}</button>`
            : ''
      }`.value;
    };
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-bar]');
      // Pages come from the phone's saved copy, so go via the network to meet the login.
      if (b?.dataset.bar === 'signin') location.href = `/api/signin?to=${encodeURIComponent(location.pathname + location.search)}`;
      if (b?.dataset.bar === 'dismiss') dismiss();
    });
    paintBar();
    subscribe(paintBar);

    // Who is using this phone? Asked once, so changes say "Clara added…".
    const who = document.querySelector<HTMLElement>('[data-whoami]')!;
    const paintWho = () => {
      who.hidden = Boolean(me());
      if (who.hidden) return;
      who.innerHTML = html`<p class="w500">${t('who.q')}</p>
        <p class="t13 muted">${t('who.why')}</p>
        <div class="chips">${TRAVELLERS.map((name) => html`<button type="button" class="chip" data-me="${name}">${t('who.me', { name })}</button>`)}</div>`.value;
    };
    who.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-me]');
      if (b) setMe(b.dataset.me!);
    });
    paintWho();
    subscribe(paintWho);
  }
</script>
