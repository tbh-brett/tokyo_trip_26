{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "tokyo-trip-26",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  // Pages are static files in ./dist. Only /api/* runs Worker code; everything
  // else is served straight from the assets, free and uncounted.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // The shared plan lives in one SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "TRIP", "class_name": "TripStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripStore"] }],
  "observability": { "enabled": true },
  // Production lives on workers.dev behind Cloudflare Access.
  // Per-version preview URLs are off so there is no second, unprotected address.
  "workers_dev": true,
  "preview_urls": false
}
